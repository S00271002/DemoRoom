{
  "openapi": "3.0.3",
  "info": {
    "title": "DemoRoom API",
    "version": "1.0.0",
    "description": "Part 1 backend for band demos, audio revisions and version-specific feedback. Registration and login verify credentials only; sessions and complete authorisation are not implemented. Mutations use the configured DEV_USER_ID. Audio is stored locally. PUT replaces editable demo metadata; new recordings are created through the version endpoint."
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Local development server"
    }
  ],
  "tags": [
    {
      "name": "Demos"
    },
    {
      "name": "Versions"
    },
    {
      "name": "Comments"
    },
    {
      "name": "Bands"
    },
    {
      "name": "Users"
    }
  ],
  "paths": {
    "/": {
      "get": {
        "tags": [
          "Demos"
        ],
        "summary": "Check server is running",
        "responses": {
          "200": {
            "description": "Server status",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string",
                  "example": "DemoRoom server is running"
                }
              }
            }
          }
        }
      }
    },
    "/api/demos": {
      "get": {
        "tags": [
          "Demos"
        ],
        "summary": "List all demos",
        "responses": {
          "200": {
            "description": "All demos",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Demo"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid URL, JSON, fields or file",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Server or database failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Demos"
        ],
        "summary": "Upload a new demo and version 1",
        "description": "Submit multipart fields with one audio file. The server assigns the development uploader and initial change note, links the first version, and returns both records.",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/DemoUpload"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Demo and initial recording created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DemoCreation"
                }
              }
            }
          },
          "400": {
            "description": "Invalid URL, JSON, fields or file",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Development user is not a member of this band",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Band not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "MP3 exceeds 50 MiB",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Server or database failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/demos/{id}": {
      "get": {
        "tags": [
          "Demos"
        ],
        "summary": "Get one demo",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Demo MongoDB ObjectId",
            "schema": {
              "type": "string",
              "pattern": "^[a-fA-F0-9]{24}$",
              "example": "6acae2f4e205dac0284f8c68"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Demo found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Demo"
                }
              }
            }
          },
          "400": {
            "description": "Invalid URL, JSON, fields or file",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Demo not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Server or database failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "Demos"
        ],
        "summary": "Replace demo metadata",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Demo MongoDB ObjectId",
            "schema": {
              "type": "string",
              "pattern": "^[a-fA-F0-9]{24}$",
              "example": "6acae2f4e205dac0284f8c68"
            }
          }
        ],
        "description": "Requires title and description. Optional tempo and key are removed when omitted. Band, uploader, identity, recording history and current version are preserved.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DemoDetails"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated demo",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Demo"
                }
              }
            }
          },
          "400": {
            "description": "Invalid URL, JSON, fields or file",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Demo not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Server or database failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "patch": {
        "tags": [
          "Demos"
        ],
        "summary": "Update selected demo metadata",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Demo MongoDB ObjectId",
            "schema": {
              "type": "string",
              "pattern": "^[a-fA-F0-9]{24}$",
              "example": "6acae2f4e205dac0284f8c68"
            }
          }
        ],
        "description": "At least one recognised field is required. Band and uploader are preserved.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DemoPatch"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated demo",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Demo"
                }
              }
            }
          },
          "400": {
            "description": "Invalid URL, JSON, fields or file",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Demo not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Server or database failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Demos"
        ],
        "summary": "Delete demo and related versions, comments and audio",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Demo MongoDB ObjectId",
            "schema": {
              "type": "string",
              "pattern": "^[a-fA-F0-9]{24}$",
              "example": "6acae2f4e205dac0284f8c68"
            }
          }
        ],
        "description": "Destructive. Database operations and filesystem cleanup are not a single transaction.",
        "responses": {
          "204": {
            "description": "Deleted; no response body"
          },
          "400": {
            "description": "Invalid URL, JSON, fields or file",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Demo not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Server or database failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/demos/{id}/versions": {
      "get": {
        "tags": [
          "Versions"
        ],
        "summary": "List a demo's recording versions",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Demo MongoDB ObjectId",
            "schema": {
              "type": "string",
              "pattern": "^[a-fA-F0-9]{24}$",
              "example": "6acae2f4e205dac0284f8c68"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Versions ordered by version number",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/DemoVersion"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid URL, JSON, fields or file",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Demo not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Server or database failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Versions"
        ],
        "summary": "Upload a new audio revision",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Demo MongoDB ObjectId",
            "schema": {
              "type": "string",
              "pattern": "^[a-fA-F0-9]{24}$",
              "example": "6acae2f4e205dac0284f8c68"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/VersionUpload"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Recording created and made current",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DemoVersion"
                }
              }
            }
          },
          "400": {
            "description": "Invalid URL, JSON, fields or file",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Demo not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "MP3 exceeds 50 MiB",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Server or database failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/demos/{id}/versions/{versionId}": {
      "get": {
        "tags": [
          "Versions"
        ],
        "summary": "Get a recording by its version number",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Demo MongoDB ObjectId",
            "schema": {
              "type": "string",
              "pattern": "^[a-fA-F0-9]{24}$",
              "example": "6acae2f4e205dac0284f8c68"
            }
          },
          {
            "name": "versionId",
            "in": "path",
            "required": true,
            "description": "Version number within this demo (not the MongoDB version _id)",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "example": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Version found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DemoVersion"
                }
              }
            }
          },
          "400": {
            "description": "Invalid URL, JSON, fields or file",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Demo or version not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Server or database failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/demos/{id}/versions/{versionId}/audio": {
      "get": {
        "tags": [
          "Versions"
        ],
        "summary": "Stream a saved MP3",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Demo MongoDB ObjectId",
            "schema": {
              "type": "string",
              "pattern": "^[a-fA-F0-9]{24}$",
              "example": "6acae2f4e205dac0284f8c68"
            }
          },
          {
            "name": "versionId",
            "in": "path",
            "required": true,
            "description": "Version number within this demo (not the MongoDB version _id)",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "example": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "MP3 audio",
            "content": {
              "audio/mpeg": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "206": {
            "description": "Partial MP3 audio for a byte-range request",
            "content": {
              "audio/mpeg": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "400": {
            "description": "Invalid URL, JSON, fields or file",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Version not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Server or database failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
