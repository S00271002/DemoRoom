    "/api/bands": {
      "get": {
        "tags": [
          "Bands"
        ],
        "summary": "List the development user's bands",
        "responses": {
          "200": {
            "description": "Bands containing DEV_USER_ID",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Band"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid URL, JSON, fields or file",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Server or database failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
