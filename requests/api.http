@baseUrl = http://localhost:3000
@missingId = 000000000000000000000000
@bandId = {{createBand.response.body.$._id}}
@demoId = {{createDemo.response.body.$.demo._id}}

# @name createBand
POST {{baseUrl}}/api/bands
Content-Type: application/json

{"name":"Example Band"}

### 1.	POST request with correct data (201)
# @name createDemo
POST {{baseUrl}}/api/demos
Content-Type: multipart/form-data; boundary=DemoRoomBoundary

--DemoRoomBoundary
Content-Disposition: form-data; name="title"

Submission Demo
--DemoRoomBoundary
Content-Disposition: form-data; name="description"

Description of the demo
--DemoRoomBoundary
Content-Disposition: form-data; name="bandId"

{{bandId}}
--DemoRoomBoundary
Content-Disposition: form-data; name="tempo"

120
--DemoRoomBoundary
Content-Disposition: form-data; name="key"

Am
--DemoRoomBoundary
Content-Disposition: form-data; name="audio"; filename="rc.mp3"
Content-Type: audio/mpeg

< C:/Users/woodw/Music/rc.mp3
--DemoRoomBoundary--

### 2.	POST request which fails validation. (400: blank title)
POST {{baseUrl}}/api/demos
Content-Type: multipart/form-data; boundary=DemoRoomBoundary

--DemoRoomBoundary
Content-Disposition: form-data; name="title"

   
--DemoRoomBoundary
Content-Disposition: form-data; name="description"

Invalid title test
--DemoRoomBoundary
Content-Disposition: form-data; name="bandId"

{{bandId}}
--DemoRoomBoundary
Content-Disposition: form-data; name="audio"; filename="rc.mp3"
Content-Type: audio/mpeg

< C:/Users/woodw/Music/rc.mp3
--DemoRoomBoundary--

### 3.	GET request on the set of resources. (200)
GET {{baseUrl}}/api/demos

### 4.	GET request on an individual resource with succeeds. (200)
GET {{baseUrl}}/api/demos/{{demoId}}

### 5.	GET request on an individual resource which fails. (404)
GET {{baseUrl}}/api/demos/{{missingId}}

### 8.	PUT request on an individual resource which succeeds. (200)
PUT {{baseUrl}}/api/demos/{{demoId}}
Content-Type: application/json

{"title":"Updated Submission Demo","description":"Updated draft","tempo":125,"key":"Am"}

### 9.	PUT request on an individual resource which fails as the resource cannot be found. (404)
PUT {{baseUrl}}/api/demos/{{missingId}}
Content-Type: application/json

{"title":"Missing demo","description":"Valid details"}

### 10.	PUT request on an individual resource which fails as the data is not valid. (400)
PUT {{baseUrl}}/api/demos/{{demoId}}
Content-Type: application/json

{"title":"","description":"Invalid tempo test","tempo":0}


### Extra: upload version 2 (201)
POST {{baseUrl}}/api/demos/{{demoId}}/versions
Content-Type: multipart/form-data; boundary=DemoRoomBoundary

--DemoRoomBoundary
Content-Disposition: form-data; name="changeNote"

Added a chorus
--DemoRoomBoundary
Content-Disposition: form-data; name="audio"; filename="revision.mp3"
Content-Type: audio/mpeg

< C:/Users/woodw/Music/rc.mp3
--DemoRoomBoundary--

### Extra: listen to original recording (200 audio)
GET {{baseUrl}}/api/demos/{{demoId}}/versions/1/audio

### Extra: comment on original recording (201)
POST {{baseUrl}}/api/demos/{{demoId}}/versions/1/comments
Content-Type: application/json

{"text":"I like this original guitar part"}


### Extra: original recording's comments (200)
GET {{baseUrl}}/api/demos/{{demoId}}/versions/1/comments

### Extra: revision's comments are separate (200)
GET {{baseUrl}}/api/demos/{{demoId}}/versions/2/comments

### Extra: register test account (201 first time, 409 if repeated)
POST {{baseUrl}}/api/users/register
Content-Type: application/json

{"username":"SubmissionTester","email":"submissiontester@example.com","password":"A-long-test-password-123!"}

### DELETE existing demo (204)
DELETE {{baseUrl}}/api/demos/{{demoId}}

### DELETE the same demo again (404)
DELETE {{baseUrl}}/api/demos/{{demoId}}
